# Template for local dev. Copy to .env and fill in secrets:
#   cp .env.example .env
# .env is gitignored; .env.example IS committed.

ANTHROPIC_API_KEY=sk-ant-...

KA_LLM_MODE=anthropic
KA_ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

KA_OPENSEARCH_URL=http://localhost:9200
KA_OPENSEARCH_INDEX=kb-chunks
KA_TOP_K=8
KA_RERANK_TOP_N=4

KA_ADDR=:8080

# ---- GitLab ingestion (self-managed instance) ----
KA_GITLAB_URL=https://gitlab.acme.com
KA_GITLAB_TOKEN=glpat-...
KA_GITLAB_PROJECT=group/subgroup/knowledge
KA_GITLAB_REF=main
KA_GITLAB_PATH=docs
KA_GITLAB_INCLUDE_REPO=true
KA_GITLAB_INCLUDE_WIKI=true
