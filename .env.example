# Template for local dev. Copy to .env and fill in secrets:
#   cp .env.example .env
# .env is gitignored; .env.example IS committed.

ANTHROPIC_API_KEY=sk-ant-...

KA_LLM_MODE=anthropic
KA_ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

KA_OPENSEARCH_URL=http://localhost:9200
KA_OPENSEARCH_INDEX=kb-chunks
KA_TOP_K=8
KA_RERANK_TOP_N=6
# Hard ceiling on chunks in the prompt, after sibling backfill.
KA_MAX_CONTEXT=10

# ---- Ollama endpoints ----
# The docker-compose ollama publishes 11435 on the host and holds the
# embedding model. Keep this off 11434 if you also run the native
# Ollama.app: the app binds IPv4 127.0.0.1:11434 and a container port
# binding takes IPv6 [::]:11434, so both can listen on "11434" with no bind
# error, and localhost resolves IPv4-first -- embed calls then land on the
# app and 404 on a model it does not have.
KA_OLLAMA_URL=http://localhost:11435

# ---- Reranker ----
# "ollama" reorders the retrieval pool with a local chat model before
# KA_RERANK_TOP_N cuts it; "off" leaves vector-search order.
KA_RERANK_MODE=off
KA_RERANK_MODEL=gpt-oss:20b
# Defaults to KA_OLLAMA_URL -- set it explicitly when the rerank model lives
# in a different Ollama than the embedding model (e.g. the native app on
# 11434, which can use Metal, while embeddings stay in the container).
#KA_RERANK_URL=http://localhost:11434
KA_RERANK_TIMEOUT=45s

# ---- Follow-up query rewriting ----
# Resolves "I am asking about AVR" into a standalone search query using the
# conversation so far. Runs only on turns that have history. Retrieval only --
# the model still answers the question the user actually typed.
KA_REWRITE_MODE=off
KA_REWRITE_MODEL=gpt-oss:20b
KA_REWRITE_TIMEOUT=20s

# "single" retrieves on the rewritten query alone; "dual" retrieves on the
# question AND its rewrite and merges, so a poor rewrite cannot lose chunks.
# Dual also rewrites first turns, which single skips. Needs a reranker to
# sort the larger pool.
KA_RETRIEVE_MODE=single

KA_ADDR=:8080

# ---- GitLab ingestion (self-managed instance) ----
KA_GITLAB_URL=https://gitlab.acme.com
KA_GITLAB_TOKEN=glpat-...
KA_GITLAB_PROJECT=group/subgroup/knowledge
KA_GITLAB_REF=main
KA_GITLAB_PATH=docs
KA_GITLAB_INCLUDE_REPO=true
KA_GITLAB_INCLUDE_WIKI=true
