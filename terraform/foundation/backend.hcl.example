# Prefer `make tf-backend`, which writes backend.hcl from the bootstrap stack's
# outputs. This example is the manual fallback: copy it to backend.hcl (gitignored),
# set bucket to the bootstrap stack's state_bucket_name output, then run:
#   terraform init -backend-config=backend.hcl
bucket       = "ka-tfstate-000000000000"
key          = "foundation/terraform.tfstate"
region       = "us-east-1"
use_lockfile = true
encrypt      = true
